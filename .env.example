# Copy to .env.local for local testing with `vercel dev`, and add the same
# variables in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# SMTP server. GYA standard is SMTP2GO.
SMTP_HOST=mail.smtp2go.com
# 587 or 2525 use STARTTLS; 465 uses SSL.
SMTP_PORT=2525
# SMTP user created in the SMTP2GO dashboard (not the account login).
SMTP_USER=lavastreetdental-website
SMTP_PASS=change-me

# Inboxes that receive waitlist sign-ups and enquiries, separated by commas.
WAITLIST_TO_EMAIL=info@lavastreetdental.com.au

# Sender shown on the emails. Must be on the domain verified in SMTP2GO.
WAITLIST_FROM_EMAIL="Lava Street Dental <hello@lavastreetdental.com.au>"

# Copy to .env for local testing, and add the same variables in
# Vercel > Project > Settings > Environment Variables. Never commit real values.
# README-CMS.md explains each one and where to get it.

# ---- Website dashboard (/admin)
# Neon Postgres connection string (Vercel > Storage > Neon adds it for you).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Vercel Blob token for photo uploads (Vercel > Storage > Blob adds it for you).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
# Any random string of 32 characters or more. Signs dashboard sign-ins.
PAYLOAD_SECRET=replace-with-a-long-random-string-of-32-plus-characters
# Vercel deploy hook (Settings > Git > Deploy Hooks, branch main). Publish website calls it.
PUBLISH_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxxx/xxxx
# The live site address, no slash at the end.
NEXT_PUBLIC_SERVER_URL=https://lavastreetdental.com.au
# Only for the very first sign in, then delete it and redeploy.
# ALLOW_FIRST_USER=true

# ---- Forms (waitlist and contact page), unchanged since v1.2.2
# SMTP2GO API key (SMTP2GO > Sending > API Keys).
SMTP2GO_API_KEY=api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional. Sender on the SMTP2GO-verified domain.
FORM_FROM="Lava Street Dental <hello@lavastreetdental.com.au>"
# Optional. Recipients, separated by commas. Wins over the list in Site Settings; without either,
# info@lavastreetdental.com.au and rowayne@gyaclients.com get them (src/forms/mail.ts).
FORM_TO=info@lavastreetdental.com.au,rowayne@gyaclients.com

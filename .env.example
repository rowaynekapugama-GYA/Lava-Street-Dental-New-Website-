# Copy to .env.local for local testing with `vercel dev`, and add the same
# variables in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Required. SMTP2GO API key (SMTP2GO > Sending > API Keys).
SMTP2GO_API_KEY=api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Sender on the SMTP2GO-verified domain.
FORM_FROM="Lava Street Dental <hello@lavastreetdental.com.au>"

# Optional. Recipients, separated by commas. Without it the fallback in
# api/_lib/forms.js is used (info@lavastreetdental.com.au, rowayne@gyaclients.com).
FORM_TO=info@lavastreetdental.com.au,rowayne@gyaclients.com
